# Environment variables for local-RAG backend

# Tokenizers - Disable parallelism warning for Hugging Face tokenizers
# Set to 'false' to avoid forking issues, or 'true' if you're not using multiprocessing
TOKENIZERS_PARALLELISM=false

# Logging
LOG_LEVEL=INFO

# Model Cache Directory (optional)
# TRANSFORMERS_CACHE=/path/to/cache
# HF_HOME=/path/to/cache
